# ─────────────────────────────────────────────────────────────────────────────
# Outlook → Google Calendar Sync — Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Microsoft / Outlook ───────────────────────────────────────────────────────
# Azure AD App Registration → Application (client) ID
OUTLOOK_CLIENT_ID=your-azure-app-client-id-here

# Tenant ID. Use "common" to allow any Microsoft account (personal + work/school),
# or set to your specific tenant ID (e.g. "contoso.onmicrosoft.com") for org accounts.
OUTLOOK_TENANT_ID=common

# ── Google Calendar ───────────────────────────────────────────────────────────
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console.
# The file should be named "google_credentials.json" and placed in the same
# directory as sync.py, or set the full path here.
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# ── Sync Behaviour ────────────────────────────────────────────────────────────
# Name of the Google Calendar to write events into.
# The calendar is created automatically if it doesn't exist.
TARGET_CALENDAR_NAME=Outlook Sync

# How often to sync, in seconds. Default: 60 (every minute).
SYNC_INTERVAL_SECONDS=60

