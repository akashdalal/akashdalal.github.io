# ─────────────────────────────────────────────────────────────────────────────
# Calendar Bridge — Configuration
# Copy this file to .env and fill in the values below.
# ─────────────────────────────────────────────────────────────────────────────

# ICS feed URL from Outlook Web (no Azure registration or admin consent needed)
#
# How to get it:
#   1. Open https://outlook.office.com
#   2. Settings (⚙) → View all Outlook settings → Calendar → Shared calendars
#   3. Under "Publish a calendar":
#        • Choose the calendar you want to sync
#        • Set permission to "Can view all details"
#        • Click Publish
#   4. Copy the .ics link and paste it here
#
ICS_URL=https://outlook.office365.com/owa/calendar/REPLACE_WITH_YOUR_ICS_LINK/calendar.ics

# Path to your Google OAuth 2.0 credentials JSON file.
# How to get it:
#   1. Go to https://console.cloud.google.com
#   2. Create or select a project
#   3. Enable the "Google Calendar API"
#   4. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#        • Application type: Desktop app
#   5. Download JSON → save it as google_credentials.json next to this file
#
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Name of the Google Calendar to sync events into.
# The calendar will be created automatically if it doesn't exist.
TARGET_CALENDAR_NAME=Outlook (Work)

# How often to check for new/changed events (in seconds).
# Default: 300 (every 5 minutes)
SYNC_INTERVAL_SECONDS=300

# How many days into the past to sync (default: 30)
DAYS_PAST=30

# How many days into the future to sync (default: 365)
DAYS_FUTURE=365
